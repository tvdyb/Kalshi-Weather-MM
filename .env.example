# Kalshi credentials
KALSHI_KEY_ID=replace-with-trading-key-id
KALSHI_PRIVATE_KEY_PATH=~/.kweather/kalshi.pem
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2

# Operating mode: paper or live
KWEATHER_MODE=paper

# Hard kill switch — set to 1 to cancel all orders and refuse new placements
KWEATHER_KILL_SWITCH=0

# Web
KWEATHER_HTTP_PORT=8000
KWEATHER_HTTP_HOST=127.0.0.1

# Storage
KWEATHER_DB_PATH=~/.kweather/kweather.db
KWEATHER_CACHE_DIR=~/.kweather/cache

# Risk
KWEATHER_DAILY_LOSS_STOP_USD=200
